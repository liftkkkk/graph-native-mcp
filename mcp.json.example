{
  "_comment": "graph-native-mcp client configuration example. Copy the servers you need into your MCP client config (zcode / Claude Code / Cursor / any MCP host) — this project was built to plug into zcode + GLM-5.3, giving the model graph-native capabilities it lacks natively. All four servers share one SQLite store via GNM_DB. Install first: pip install graph-native-mcp  (or run from source: python -m graph_native_mcp.cli <server>).",
  "mcpServers": {
    "graph-memory": {
      "command": "gnm",
      "args": ["memory"],
      "env": {
        "GNM_DB": "C:/Users/yourname/.gnm/graph.db"
      }
    },
    "graph-rag": {
      "command": "gnm",
      "args": ["rag"],
      "env": {
        "GNM_DB": "C:/Users/yourname/.gnm/graph.db"
      }
    },
    "graph-build": {
      "command": "gnm",
      "args": ["build"],
      "env": {
        "GNM_DB": "C:/Users/yourname/.gnm/graph.db"
      }
    },
    "graph-agent": {
      "command": "gnm",
      "args": ["agent"],
      "env": {
        "GNM_DB": "C:/Users/yourname/.gnm/graph.db"
      }
    }
  },
  "_notes": {
    "minimal_setup": "只挂 memory + rag 就能用（离线、零 API key）。嵌入默认用确定性 hash 后端，配置 GNM_EMBED_* 换成语义嵌入。",
    "build_zero_key": "graph-build 默认不需要任何 LLM key：抽取由调用方的 LLM 完成（工具返回抽取 prompt，模型产出 JSON 后带 extraction_json 重调）。GNM_LLM_* 仅在无 agent 的批量导入时可选配置。",
    "separation": "rag 只读无 LLM；agent 确定性无 LLM；build 的生成步骤在调用方，服务端只做链接/门控/校验/执行等确定性部分。",
    "sharing": "四个 server 通过同一个 GNM_DB 共享数据，彼此零调用。"
  }
}
